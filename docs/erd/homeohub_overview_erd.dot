digraph HomeoHub {
  graph [fontname="DejaVu Sans", rankdir=TB, newrank=true, splines=true, nodesep=0.55, ranksep=0.75, pad=0.4, bgcolor="white",
         labelloc="t", label=<<FONT POINT-SIZE="22"><B>HomeoHub — Database Schema (overview)</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#666666">33 core tables · patients / doctors / locations / shops / remedies / illnesses / self-prescription / doctor-consultancy / commerce</FONT><BR/> >];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8, color="#5f6b78", penwidth=1.0, arrowsize=0.8];
  subgraph cluster_patients {
    label=<<B>patients</B>>; fontcolor="#1f6feb"; fontsize=13; style="rounded,filled"; fillcolor="#edf3fe"; color="#1f6feb"; penwidth=1.2; margin=14;
    Patient [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#1f6feb" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Patient</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#edf3fe" ALIGN="LEFT" BALIGN="LEFT">phone  <FONT COLOR="#8c8c8c">UQ</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">password  <FONT COLOR="#8c8c8c">hash</FONT></TD></TR><TR><TD BGCOLOR="#edf3fe" ALIGN="LEFT" BALIGN="LEFT">full_name</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">gender / date_of_birth</TD></TR><TR><TD BGCOLOR="#edf3fe" ALIGN="LEFT" BALIGN="LEFT">location_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">preferred_language  <FONT COLOR="#8c8c8c">bn / en</FONT></TD></TR><TR><TD BGCOLOR="#edf3fe" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_doctors {
    label=<<B>doctors</B>>; fontcolor="#7b4fd6"; fontsize=13; style="rounded,filled"; fillcolor="#f2edfb"; color="#7b4fd6"; penwidth=1.2; margin=14;
    Doctor [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#7b4fd6" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Doctor</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#f2edfb" ALIGN="LEFT" BALIGN="LEFT">doctor_code  <FONT COLOR="#8c8c8c">UQ null</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">phone / password</TD></TR><TR><TD BGCOLOR="#f2edfb" ALIGN="LEFT" BALIGN="LEFT">registration_no  <FONT COLOR="#8c8c8c">UQ</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">full_name</TD></TR><TR><TD BGCOLOR="#f2edfb" ALIGN="LEFT" BALIGN="LEFT">qualifications / experience</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">location_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f2edfb" ALIGN="LEFT" BALIGN="LEFT">chamber_address</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">consultation_fee  <FONT COLOR="#8c8c8c">poisha</FONT></TD></TR><TR><TD BGCOLOR="#f2edfb" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">specialities  <FONT COLOR="#8c8c8c">M2M</FONT></TD></TR></TABLE>>];
    Speciality [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#7b4fd6" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Speciality</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#f2edfb" ALIGN="LEFT" BALIGN="LEFT">name / slug</TD></TR></TABLE>>];
  }
  subgraph cluster_locations {
    label=<<B>locations</B>>; fontcolor="#5d6d7e"; fontsize=13; style="rounded,filled"; fillcolor="#f0f3f5"; color="#5d6d7e"; penwidth=1.2; margin=14;
    Location [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#5d6d7e" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Location</B></FONT></TD></TR><TR><TD BGCOLOR="#5d6d7e" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">area list</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#f0f3f5" ALIGN="LEFT" BALIGN="LEFT">division</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">district</TD></TR><TR><TD BGCOLOR="#f0f3f5" ALIGN="LEFT" BALIGN="LEFT">upazila_thana</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">name  <FONT COLOR="#8c8c8c">en / bn</FONT></TD></TR><TR><TD BGCOLOR="#f0f3f5" ALIGN="LEFT" BALIGN="LEFT">(division, district, upazila)  <FONT COLOR="#8c8c8c">UNIQUE</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_shops {
    label=<<B>shops</B>>; fontcolor="#0f7a5c"; fontsize=13; style="rounded,filled"; fillcolor="#e7f6f0"; color="#0f7a5c"; penwidth=1.2; margin=14;
    Shop [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#0f7a5c" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Shop</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">name / slug  <FONT COLOR="#8c8c8c">UQ</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">location_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">address_line / phone</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">latitude / longitude  <FONT COLOR="#8c8c8c">null</FONT></TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">is_verified / is_active</TD></TR></TABLE>>];
    ShopStaff [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#0f7a5c" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>ShopStaff</B></FONT></TD></TR><TR><TD BGCOLOR="#0f7a5c" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">who manages the shop</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">shop_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">user_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">role  <FONT COLOR="#8c8c8c">owner / staff</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">(shop, user)  <FONT COLOR="#8c8c8c">UNIQUE</FONT></TD></TR></TABLE>>];
    ShopRemedy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#0f7a5c" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>ShopRemedy</B></FONT></TD></TR><TR><TD BGCOLOR="#0f7a5c" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">shop&#x27;s own price list, admin-only</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">shop_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">remedy_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">pack_size / unit</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">price  <FONT COLOR="#8c8c8c">poisha, shop&#x27;s price</FONT></TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">stock_qty / reserved_qty</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">is_available</TD></TR><TR><TD BGCOLOR="#e7f6f0" ALIGN="LEFT" BALIGN="LEFT">(shop, remedy, pack)  <FONT COLOR="#8c8c8c">UNIQUE</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_remedies {
    label=<<B>remedies</B>>; fontcolor="#00838f"; fontsize=13; style="rounded,filled"; fillcolor="#e4f5f6"; color="#00838f"; penwidth=1.2; margin=14;
    Remedy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#00838f" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Remedy</B></FONT></TD></TR><TR><TD BGCOLOR="#00838f" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">the medicine only</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#e4f5f6" ALIGN="LEFT" BALIGN="LEFT">name  <FONT COLOR="#8c8c8c">UQ, Latin</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">slug  <FONT COLOR="#8c8c8c">UQ</FONT></TD></TR><TR><TD BGCOLOR="#e4f5f6" ALIGN="LEFT" BALIGN="LEFT">description  <FONT COLOR="#8c8c8c">en / bn</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">indication  <FONT COLOR="#8c8c8c">en / bn</FONT></TD></TR><TR><TD BGCOLOR="#e4f5f6" ALIGN="LEFT" BALIGN="LEFT">advice_do / advice_dont  <FONT COLOR="#8c8c8c">en / bn</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR></TABLE>>];
    RemedyPrice [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#00838f" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>RemedyPrice</B></FONT></TD></TR><TR><TD BGCOLOR="#00838f" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">the only price patients see</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#e4f5f6" ALIGN="LEFT" BALIGN="LEFT">remedy_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">type  <FONT COLOR="#8c8c8c">pill / liquid</FONT></TD></TR><TR><TD BGCOLOR="#e4f5f6" ALIGN="LEFT" BALIGN="LEFT">price  <FONT COLOR="#8c8c8c">poisha</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">is_active</TD></TR><TR><TD BGCOLOR="#e4f5f6" ALIGN="LEFT" BALIGN="LEFT">(remedy, type)  <FONT COLOR="#8c8c8c">UNIQUE</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_illnesses {
    label=<<B>illnesses</B>>; fontcolor="#c2510a"; fontsize=13; style="rounded,filled"; fillcolor="#fdf1e8"; color="#c2510a"; penwidth=1.2; margin=14;
    IllnessCategory [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#c2510a" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>IllnessCategory</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">name / slug</TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">sort_order</TD></TR></TABLE>>];
    Illness [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#c2510a" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Illness</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">category_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">name  <FONT COLOR="#8c8c8c">en / bn</FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">slug  <FONT COLOR="#8c8c8c">UQ</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">short_description</TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR></TABLE>>];
    IllnessRemedy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#c2510a" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>IllnessRemedy</B></FONT></TD></TR><TR><TD BGCOLOR="#c2510a" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">links illness to remedies</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">illness_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">remedy_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#fdf1e8" ALIGN="LEFT" BALIGN="LEFT">rank  <FONT COLOR="#8c8c8c">1 = best</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">(illness, remedy)  <FONT COLOR="#8c8c8c">UNIQUE</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_selfrx {
    label=<<B>self_prescription</B>>; fontcolor="#8a6d3b"; fontsize=13; style="rounded,filled"; fillcolor="#f7f2e8"; color="#8a6d3b"; penwidth=1.2; margin=14;
    SelfPrescription [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#8a6d3b" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>SelfPrescription</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#f7f2e8" ALIGN="LEFT" BALIGN="LEFT">patient_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">illness_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f2e8" ALIGN="LEFT" BALIGN="LEFT">location_id  <FONT COLOR="#8c8c8c">FK null, for nearby shops</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">created_at</TD></TR></TABLE>>];
    SelfPrescriptionItem [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#8a6d3b" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>SelfPrescriptionItem</B></FONT></TD></TR><TR><TD BGCOLOR="#8a6d3b" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">advice comes from Remedy</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#f7f2e8" ALIGN="LEFT" BALIGN="LEFT">self_prescription_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">remedy_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f2e8" ALIGN="LEFT" BALIGN="LEFT">potency  <FONT COLOR="#8c8c8c">set by patient</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">type  <FONT COLOR="#8c8c8c">pill / liquid, set by patient</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_consult {
    label=<<B>doctor_consultancy</B>>; fontcolor="#c62f3b"; fontsize=13; style="rounded,filled"; fillcolor="#fdecee"; color="#c62f3b"; penwidth=1.2; margin=14;
    DoctorConsultation [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#c62f3b" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>DoctorConsultation</B></FONT></TD></TR><TR><TD BGCOLOR="#c62f3b" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">the case</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fdecee" ALIGN="LEFT" BALIGN="LEFT">code  <FONT COLOR="#8c8c8c">UQ</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">patient_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#fdecee" ALIGN="LEFT" BALIGN="LEFT">location_id  <FONT COLOR="#8c8c8c">FK, patient&#x27;s area</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">doctor_id  <FONT COLOR="#8c8c8c">FK null</FONT></TD></TR><TR><TD BGCOLOR="#fdecee" ALIGN="LEFT" BALIGN="LEFT">primary / secondary / tertiary_concern  <FONT COLOR="#8c8c8c">text</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR><TR><TD BGCOLOR="#fdecee" ALIGN="LEFT" BALIGN="LEFT">parent_id  <FONT COLOR="#8c8c8c">self-FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">submitted_at / completed_at</TD></TR></TABLE>>];
  }
  subgraph cluster_quest {
    label=<<B>questionnaires</B>>; fontcolor="#b5367a"; fontsize=13; style="rounded,filled"; fillcolor="#fbebf4"; color="#b5367a"; penwidth=1.2; margin=14;
    QuestionSet [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#b5367a" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>QuestionSet</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fbebf4" ALIGN="LEFT" BALIGN="LEFT">consultation_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">doctor_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#fbebf4" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">sent_at / answered_at</TD></TR></TABLE>>];
    Question [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#b5367a" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Question</B></FONT></TD></TR><TR><TD BGCOLOR="#b5367a" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">frozen copy</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fbebf4" ALIGN="LEFT" BALIGN="LEFT">question_set_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">text  <FONT COLOR="#8c8c8c">en / bn</FONT></TD></TR><TR><TD BGCOLOR="#fbebf4" ALIGN="LEFT" BALIGN="LEFT">question_type  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">options  <FONT COLOR="#8c8c8c">json</FONT></TD></TR></TABLE>>];
    Answer [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#b5367a" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Answer</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fbebf4" ALIGN="LEFT" BALIGN="LEFT">question_id  <FONT COLOR="#8c8c8c">FK UQ</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">value  <FONT COLOR="#8c8c8c">json</FONT></TD></TR><TR><TD BGCOLOR="#fbebf4" ALIGN="LEFT" BALIGN="LEFT">file_id  <FONT COLOR="#8c8c8c">FK null</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_rx {
    label=<<B>prescriptions</B>>; fontcolor="#3949ab"; fontsize=13; style="rounded,filled"; fillcolor="#ebedf8"; color="#3949ab"; penwidth=1.2; margin=14;
    Prescription [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#3949ab" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Prescription</B></FONT></TD></TR><TR><TD BGCOLOR="#3949ab" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">immutable, versioned</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">consultation_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">version</TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">previous_id  <FONT COLOR="#8c8c8c">self-FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">active / superseded</FONT></TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">report_after_date</TD></TR></TABLE>>];
    PrescriptionItem [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#3949ab" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>PrescriptionItem</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">prescription_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">remedy_id  <FONT COLOR="#8c8c8c">FK null</FONT></TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">potency  <FONT COLOR="#8c8c8c">set by doctor</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">type  <FONT COLOR="#8c8c8c">pill / liquid, set by doctor</FONT></TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">dosage / frequency / duration</TD></TR></TABLE>>];
    PrescriptionAdvice [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#3949ab" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>PrescriptionAdvice</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">prescription_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">kind  <FONT COLOR="#8c8c8c">DO / DONT</FONT></TD></TR><TR><TD BGCOLOR="#ebedf8" ALIGN="LEFT" BALIGN="LEFT">text</TD></TR></TABLE>>];
  }
