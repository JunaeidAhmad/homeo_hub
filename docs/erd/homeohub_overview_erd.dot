    Order [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#222222"><TR><TD BGCOLOR="#a0522d" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>Order</B></FONT></TD></TR><TR><TD BGCOLOR="#a0522d" ALIGN="CENTER"><FONT COLOR="#f2f2f2" POINT-SIZE="7">what the patient sees, one per checkout</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT"><B>PK</B>  id (UUID)</TD></TR><TR><TD BGCOLOR="#fbefe8" ALIGN="LEFT" BALIGN="LEFT">code  <FONT COLOR="#8c8c8c">UQ</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">patient_id  <FONT COLOR="#8c8c8c">FK</FONT></TD></TR><TR><TD BGCOLOR="#fbefe8" ALIGN="LEFT" BALIGN="LEFT">location_id  <FONT COLOR="#8c8c8c">FK, delivery area</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">payment_method  <FONT COLOR="#8c8c8c">online / COD</FONT></TD></TR><TR><TD BGCOLOR="#fbefe8" ALIGN="LEFT" BALIGN="LEFT">status  <FONT COLOR="#8c8c8c">enum</FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT">subtotal / delivery / total  <FONT COLOR="#8c8c8c">poisha</FONT></TD></TR><TR><TD BGCOLOR="#fbefe8" ALIGN="LEFT" BALIGN="LEFT">shipping_address  <FONT COLOR="#8c8c8c">snapshot</FONT></TD></TR></TABLE>>];
