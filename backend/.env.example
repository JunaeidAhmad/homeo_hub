# Copy to backend/.env and adjust. Real environment variables override this file.
# Never commit backend/.env.

# Django secret. Local falls back to an insecure dev key when empty;
# staging/production refuse to start without it.
SECRET_KEY=

# Comma-separated host names this API answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database this process uses: the native local Postgres 16.
# On Render this is the Neon connection string.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/homeohub

# Neon (cloud Postgres). Used locally only when USE_NEON=true,
# e.g. `USE_NEON=true python manage.py migrate` to migrate Neon from your machine.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
USE_NEON=false

# Seconds to keep DB connections open (local 0; production default 60).
DB_CONN_MAX_AGE=0

# Redis (cache, rate limits, Celery broker later).
REDIS_URL=redis://localhost:6379/0

# Comma-separated web origins allowed to call the API (scheme included).
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Anonymous requests allowed per visitor on public endpoints.
THROTTLE_PUBLIC_READ=300/min
# Proxies in front of the API (for the visitor's address). Leave unset locally.
# NUM_PROXIES=1

LOG_LEVEL=INFO
