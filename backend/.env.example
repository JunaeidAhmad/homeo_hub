# Copy to backend/.env and adjust. Real environment variables override this file.
# Never commit backend/.env.

# Django secret. Local falls back to an insecure dev key when empty;
# staging/production refuse to start without it or if it is shorter than 32 characters.
SECRET_KEY=

# Comma-separated host names this API answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database this process uses: the native local Postgres 16.
# On Render this is the Neon connection string.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/homeohub

# Neon (cloud Postgres). Used locally only when USE_NEON=true,
# e.g. `USE_NEON=true python manage.py migrate` to migrate Neon from your machine.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
USE_NEON=false

# Seconds to keep DB connections open (local 0; production default 60).
DB_CONN_MAX_AGE=0

# Redis (cache, rate limits, Celery broker later).
REDIS_URL=redis://localhost:6379/0

# Comma-separated web origins allowed to call the API (scheme included).
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Class that sends text messages. Local default prints codes to the API log; elsewhere
# the default refuses to send until a real gateway is configured.
SMS_PROVIDER=apps.accounts.sms.ConsoleSmsProvider
# Ceiling on text messages across all numbers.
OTP_MAX_SENDS_PER_HOUR=500

# Anonymous requests allowed per visitor on public endpoints.
THROTTLE_PUBLIC_READ=300/min
# Proxies in front of the API that add to X-Forwarded-For (default 1).
NUM_PROXIES=1
# Same value as the web app's PROXY_SHARED_SECRET. Required in staging/production; the
# web app uses it to tell the API which visitor a forwarded request is for.
PROXY_SHARED_SECRET=

LOG_LEVEL=INFO

# Uploaded pictures. Leave STORAGE_BUCKET empty to use backend/media (development).
# Deployed, uploads are refused until a bucket is configured.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public (CDN) host for the bucket, without https://. Empty = signed, expiring links.
STORAGE_PUBLIC_DOMAIN=

# Flat delivery charge in poisha (1 taka = 100 poisha).
DELIVERY_CHARGE_POISHA=6000

# Consultation platform fee: FIXED (poisha) or PERCENT (basis points, e.g. 500 = 5%).
PLATFORM_FEE_MODE=FIXED
PLATFORM_FEE_VALUE=0

# Payment gateway class and web app URL for payment return redirects.
PAYMENT_GATEWAY=apps.payments.gateways.mock.MockGateway
WEB_APP_URL=http://localhost:3000
